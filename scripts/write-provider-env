#!/bin/sh
# write-provider-env: write a provider.env file beside the backend socket.
#
# The myna client's --backend-dir mode scans every subdirectory in the given
# directory, looking for <dir>/<name>/provider.env:
#   SNAP_NAME=...
#   UNIX_SOCKET=<relative_socket_filename>
#
# Usage: write-provider-env <socket-path> <env-file-path> [provider-name]
set -eu

SOCKET_PATH="$1"
ENV_FILE="$2"
PROVIDER_NAME="${3:-${FLATPAK_ID:-com.canonical.Myna.Backend}}"
SOCKET_NAME=$(basename "$SOCKET_PATH")

mkdir -p "$(dirname "$ENV_FILE")"

printf 'SNAP_NAME=%s\nSNAP_INSTANCE_NAME=%s\nUNIX_SOCKET=%s\n' \
    "$PROVIDER_NAME" \
    "$PROVIDER_NAME" \
    "$SOCKET_NAME" \
    > "$ENV_FILE"
