#!/bin/sh
# myna-app: main Flatpak application launcher.
# Starts the background Whisper inference engine and Myna dictation daemon,
# then opens the Myna Settings GUI.
set -eu

cleanup() {
    for pid in $(jobs -p); do
        kill "$pid" 2>/dev/null || true
    done
    wait 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# If a subcommand or toggle flag was passed, run it immediately without probing sockets
if [ "${1:-}" = "--toggle" ] || [ "${1:-}" = "myna-toggle" ]; then
    shift || true
    exec /app/bin/myna-toggle "$@"
elif [ $# -gt 0 ] && [ -x "/app/bin/$1" ]; then
    cmd="/app/bin/$1"
    shift
    exec "$cmd" "$@"
fi

BACKEND_DIR="${XDG_RUNTIME_DIR}/myna"
mkdir -p "$BACKEND_DIR/whisper"

WHISPER_SOCKET="${BACKEND_DIR}/whisper/myna.sock"

# Function to test whether a Unix domain socket is active and accepting connections
is_socket_listening() {
    target="$1"
    [ -S "$target" ] || return 1
    python3 -c "
import socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
try:
    s.connect('$target')
    s.close()
    sys.exit(0)
except Exception:
    sys.exit(1)
" 2>/dev/null
}

# 1. Start Whisper STT server if not running or stale
if ! is_socket_listening "$WHISPER_SOCKET"; then
    echo "myna-app: starting Whisper speech-to-text backend..." >&2
    rm -f "$WHISPER_SOCKET"
    if [ -x /app/bin/myna-whisper-server ]; then
        /app/bin/myna-whisper-server >> "$BACKEND_DIR/whisper/server.log" 2>&1 &
    fi
fi

# 2. Start Myna dictation daemon if not already serving on D-Bus
# (Note: we check D-Bus rather than connecting to myna-desktop.sock, because any socket connection triggers a toggle poke!)
if ! busctl --user status com.canonical.Myna.Dictation >/dev/null 2>&1; then
    echo "myna-app: starting Myna dictation daemon..." >&2
    rm -f "${BACKEND_DIR}/myna-desktop.sock"
    if [ -x /app/bin/myna-daemon ]; then
        /app/bin/myna-daemon >> "$BACKEND_DIR/daemon.log" 2>&1 &
    fi
fi

# 3. Present Myna Settings UI
/app/bin/myna-config "$@"
