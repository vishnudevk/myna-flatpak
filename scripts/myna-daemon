#!/bin/sh
# myna-daemon (Flatpak): ExecStart for the per-user systemd service.
#
# Adaptation of myna-snap/scripts/myna-daemon for Flatpak.
#
# Key differences from the snap launcher:
#
#   Snap content interface → XDG_RUNTIME_DIR/myna/
#     In snap, the backend shares its socket directory via snapd's content
#     interface, bind-mounted into $SNAP_DATA/backend/. In Flatpak we use
#     $XDG_RUNTIME_DIR/myna/ (finish-args: --filesystem=xdg-run/myna:create),
#     which both the client and any backend Flatpak declare.  The backend
#     writes a provider.env beside its socket there; the client reads every
#     *.env in that directory at each press, exactly as myna-desktop does
#     in the snap (--backend-dir).
#
#   GSettings backend:
#     The snap uses GSETTINGS_BACKEND=keyfile + XDG_CONFIG_HOME pointing
#     at $SNAP_USER_COMMON/.config to avoid touching host dconf.
#     In Flatpak we use the same keyfile backend; Flatpak already sandboxes
#     $XDG_CONFIG_HOME to ~/.var/app/com.canonical.Myna/config/ by default,
#     so the settings file stays app-private without extra env.
#
# Env knobs (all optional):
#   MYNA_BACKEND_SOCKET  exact backend socket path (bypasses auto-discovery)
#   MYNA_LANGUAGE        language hint forwarded to the session config
#
set -eu

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    exec /app/bin/myna-desktop --help
fi

BACKEND_DIR="${XDG_RUNTIME_DIR}/myna"
mkdir -p "$BACKEND_DIR"

if [ -n "${MYNA_BACKEND_SOCKET:-}" ]; then
    set -- --socket "$MYNA_BACKEND_SOCKET" "$@"
else
    set -- --backend-dir "$BACKEND_DIR" "$@"
fi

if [ -n "${MYNA_LANGUAGE:-}" ]; then
    set -- --language "$MYNA_LANGUAGE" "$@"
fi

exec /app/bin/myna-desktop "$@"
